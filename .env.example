# Supabase Configuration (Frontend - Publishable Anon Key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Sentry Error Tracking
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Optional: Local Verification / E2E Testing
# SWAPNET_BASE_URL=http://localhost:4173
# SWAPNET_TEST_EMAIL=test@example.com
# SWAPNET_TEST_PASSWORD=your-secure-test-password
